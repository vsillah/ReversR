{
  "name": "reversr-rebuild",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "node server/index.js",
    "start:native": "npx expo start --clear --port 8081",
    "dev": "npx concurrently \"npm:api\" \"npm:start:native\"",
    "web-preview": "npx cross-env API_PORT=3001 concurrently \"node server/index.js\" \"npx expo start --web --port 5001\"",
    "web:export": "expo export --platform web --output-dir dist",
    "web:flow-smoke": "node scripts/web-flow-smoke.js",
    "preview:discover": "node scripts/discover-preview-host.js",
    "preview:smoke": "node scripts/preview-host-smoke.js",
    "policy:preflight": "node scripts/policy-hosting-preflight.js",
    "policy:preflight:local": "node scripts/policy-hosting-preflight.js --allow-placeholder",
    "store:assets:generate": "node scripts/generate-store-assets.js",
    "store:assets:preflight": "node scripts/store-assets-preflight.js",
    "screenshots:store": "node scripts/capture-store-screenshots.js",
    "release:status": "node scripts/release-status.js",
    "release:next-actions": "node scripts/release-next-actions.js",
    "release:next-actions:write": "node scripts/release-next-actions.js --write",
    "release:objective": "node scripts/objective-readiness-audit.js",
    "release:evidence": "node scripts/generate-release-evidence-bundle.js",
    "release:local-ci": "node scripts/local-release-ci.js",
    "typecheck": "tsc --noEmit",
    "api:preflight": "node scripts/api-preflight.js",
    "api:env:preflight": "node scripts/api-env-preflight.js",
    "api:env:preflight:local": "node scripts/api-env-preflight.js --allow-placeholder",
    "api:deployment-smoke": "node scripts/api-deployment-smoke.js",
    "inventory:source:validate": "node scripts/validate-machine-inventory.js",
    "inventory:preflight": "node scripts/inventory-connector-preflight.js",
    "connector:smoke": "node scripts/hosted-connector-smoke.js",
    "api:docker:build": "docker build -t reversr-rebuild-api .",
    "native:preflight": "node scripts/native-release-preflight.js",
    "native:preflight:local": "node scripts/native-release-preflight.js --allow-placeholder --allow-missing-cli --allow-unlinked-eas --allow-not-logged-in",
    "native:qa:preflight": "node scripts/native-qa-preflight.js",
    "native:qa:preflight:local": "node scripts/native-qa-preflight.js --allow-pending",
    "accessibility:preflight": "node scripts/accessibility-preflight.js",
    "store:submission:preflight": "node scripts/store-submission-preflight.js",
    "store:submission:preflight:local": "node scripts/store-submission-preflight.js --allow-placeholder",
    "store:review-safety": "node scripts/generate-store-review-safety-packet.js",
    "store:console:copy": "node scripts/generate-store-console-copy.js",
    "store:operator-packet": "node scripts/generate-store-operator-packet.js",
    "store:console:preflight": "node scripts/store-console-preflight.js",
    "store:console:preflight:local": "node scripts/store-console-preflight.js --allow-pending",
    "store:preflight": "node scripts/store-preflight.js",
    "store:preflight:local": "node scripts/store-preflight.js --allow-placeholder"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^0.14.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "^3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "express": "^5.1.0",
    "ollama": "^0.6.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "playwright": "^1.60.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
