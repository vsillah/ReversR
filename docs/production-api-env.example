# ReversR Rebuild production API environment template.
# Copy values into the hosting provider's secret/environment manager.
# Do not commit a filled .env.production file.

API_PORT=3001
API_CORS_ORIGINS=https://reversr-rebuild.your-domain.example
API_REQUEST_BODY_LIMIT=50mb

# At least one Gemini key is required for production photo analysis and AI-backed reconstruction.
AI_INTEGRATIONS_GEMINI_API_KEY=replace-with-managed-secret
GEMINI_API_KEYS=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Optional non-production local model endpoint. Do not use localhost Ollama for store builds.
OLLAMA_HOST=

# Required when enabling admin credential registry endpoints.
ADMIN_API_TOKEN=replace-with-long-random-token

# Connector secrets stay server-side. Prefer managed secret storage over registry files.
INVENTORY_CONNECTOR_SECRETS_JSON={}
INVENTORY_CONNECTOR_SECRETS_FILE=
INVENTORY_PRIVATE_NETWORK_ENABLED=false

# Commercialization MVP. Leave Stripe keys unset to keep billing endpoints disabled.
# COMMERCIAL_STORE_FILE is optional for local/dev persistence; use managed database storage before public scale.
COMMERCIAL_STORE_FILE=
COMMERCIAL_SUPER_ADMIN_EMAILS=
COMMERCIAL_SUPER_ADMIN_PASSWORD=
TESTER_INVITE_BASE_URL=https://reversr.vercel.app/account
RESEND_API_KEY=
TESTER_INVITE_EMAIL_FROM=
TESTER_INVITE_EMAIL_REPLY_TO=
TESTER_INVITE_EMAIL_SUBJECT_PREFIX=ReversR
PUBLIC_APP_URL=https://reversr.vercel.app
BILLING_RETURN_URL=https://reversr.vercel.app/account
BILLING_CANCEL_URL=https://reversr.vercel.app/account?checkout=cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_SHOP=
STRIPE_PRICE_TEAM=

# Google Play Billing verification for Android in-app subscription upgrades.
# Product IDs must match the active Google Play Console subscription products.
GOOGLE_PLAY_PACKAGE_NAME=com.vsillah.reversrrebuild
GOOGLE_PLAY_PRODUCT_PRO_SHOP=reversr_pro_shop_monthly
GOOGLE_PLAY_PRODUCT_TEAM=reversr_team_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Alternative to GOOGLE_PLAY_SERVICE_ACCOUNT_JSON:
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
