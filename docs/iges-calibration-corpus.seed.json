      },
      {
        "id": "small_assembly",
        "minimum": 2,
        "reason": "Exercises subfigure/name resolution, display states, and component relationship rendering."
      },
      {
        "id": "surface_or_wireframe_stress",
        "minimum": 1,
        "reason": "Exercises legacy IGES surface/wireframe import behavior without pretending visual QA is golden-ready."
      }
    ]
  },
