      "scene assembly",
      "renderer source data",
      "STL export",
      "source confidence score"
    ],
    "visualFidelityIsSeparateFromSourceConfidence": true
  },
  "targetMix": {
    "minimumSamples": 12,
    "preferredSamples": 20,
    "categories": [
      {
        "id": "simple_block_or_plate",
        "minimum": 2,
        "reason": "Baseline units, bounds, face shading, edge cleanliness, and camera framing."
      },
      {
        "id": "bracket_or_flange_with_holes",
        "minimum": 4,
        "reason": "Directly exercises the current bracket source/reference ambiguity and hole-plane detection."
      },
      {
        "id": "cylindrical_or_bearing",
        "minimum": 3,
        "reason": "Exercises circular silhouette, tessellation quality, center holes, and shaded curvature."
      },
      {
        "id": "small_assembly",
        "minimum": 2,
        "reason": "Exercises subfigure/name resolution, display states, and component relationship rendering."
      },
      {
        "id": "surface_or_wireframe_stress",
        "minimum": 1,
        "reason": "Exercises legacy IGES surface/wireframe import behavior without pretending visual QA is golden-ready."
      }
    ]
  },
