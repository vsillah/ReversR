{
  "expo": {
    "name": "ReversR Rebuild",
    "slug": "reversr-rebuild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vsillah.reversrrebuild",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow ReversR Rebuild to scan machines for inventory matching and reconstruction planning."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.vsillah.reversrrebuild",
      "versionCode": 15
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ReversR Rebuild to access your camera to scan machines for inventory matching."
        }
      ],
      "expo-router"
    ],
    "scheme": "reversr-rebuild",
    "extra": {
      "apiBaseUrl": "https://reversr-rebuild-api.example.com",
      "privacyPolicyUrl": "https://reversr-rebuild.example.com/privacy",
      "termsUrl": "https://reversr-rebuild.example.com/terms",
      "supportUrl": "https://reversr-rebuild.example.com/support"
    }
  }
}
