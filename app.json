{
  "expo": {
    "name": "ReversR Rebuild",
    "slug": "reversr-rebuild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vsillah.reversrrebuild",
      "buildNumber": "13",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow ReversR Rebuild to scan machines for inventory matching and reconstruction planning.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.vsillah.reversrrebuild",
      "versionCode": 28
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "updates": {
      "url": "https://u.expo.dev/700c2107-2639-4a27-b374-59ed5edd54fc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ReversR Rebuild to access your camera to scan machines for inventory matching."
        }
      ],
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "reversr-rebuild",
    "extra": {
      "apiBaseUrl": "https://reversr.vercel.app",
      "releaseDate": "2026-06-14",
      "releaseManifestUrl": "https://reversr.vercel.app/release.json",
      "privacyPolicyUrl": "https://reversr.vercel.app/privacy",
      "termsUrl": "https://reversr.vercel.app/terms",
      "supportUrl": "https://reversr.vercel.app/support",
      "androidPlayProductProShop": "reversr_pro_shop_monthly",
      "androidPlayProductTeam": "reversr_team_monthly",
      "router": {},
      "eas": {
        "projectId": "700c2107-2639-4a27-b374-59ed5edd54fc"
      }
    },
    "owner": "vsillah"
  }
}
