API_PORT=3001
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Public non-secret flag for tester/review builds. Keep Gemini/Ollama local-provider controls hidden.
EXPO_PUBLIC_FORCE_MANAGED_AI_SETTINGS=true
# Development-only public flag when engineers need local Ollama controls.
EXPO_PUBLIC_ENABLE_LOCAL_PROVIDER_SETTINGS=false
# Development/admin-only public flag when backend credential references must be managed from Settings.
EXPO_PUBLIC_ENABLE_ADMIN_CREDENTIAL_SETTINGS=false

# Comma-separated browser origins allowed to call the API.
# Native mobile requests and server-side checks generally have no Origin header.
# Use explicit production web origins before store submission.
API_CORS_ORIGINS=https://reversr-rebuild.example.com
API_REQUEST_BODY_LIMIT=50mb

# Gemini keys are required on the hosted API for TestFlight, Play Internal, and review builds.
# Store real values in 1Password and the hosting provider secret manager, not in EAS public env vars.
AI_INTEGRATIONS_GEMINI_API_KEY=
GEMINI_API_KEYS=

# Server-side inventory connector credentials.
# The mobile app stores only connector.credentialRef, never raw secrets.
# Example:
# INVENTORY_CONNECTOR_SECRETS_JSON={"partsledger-prod":{"headerName":"X-API-Key","value":"replace-me"},"maintenance-oauth":{"token":"replace-me"}}
INVENTORY_CONNECTOR_SECRETS_JSON={}

# Optional runtime registry for admin-managed connector credentials.
ADMIN_API_TOKEN=
INVENTORY_CONNECTOR_SECRETS_FILE=.reversr-connector-secrets.json

# Private-network connectors are disabled unless this is explicitly enabled on a controlled API host.
INVENTORY_PRIVATE_NETWORK_ENABLED=false

# Hosted connector smoke inputs. These are metadata only; raw connector secrets stay on the API host.
# Run after the hosted API and real inventory connector are configured:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com npm run connector:smoke
CONNECTOR_SMOKE_SOURCE_NAME=Production Machine Inventory
CONNECTOR_SMOKE_SOURCE_URL=https://inventory.example.com/machines.json
CONNECTOR_SMOKE_CONNECTOR_TYPE=json
CONNECTOR_SMOKE_AUTH_MODE=api_key
CONNECTOR_SMOKE_CREDENTIAL_REF=partsledger-prod
CONNECTOR_SMOKE_EXPECTED_MACHINE_ID=
CONNECTOR_SMOKE_MIN_CONFIDENCE=0.2
