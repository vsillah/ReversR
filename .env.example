API_PORT=3001
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Comma-separated browser origins allowed to call the API.
# Native mobile requests and server-side checks generally have no Origin header.
# Use explicit production web origins before store submission.
API_CORS_ORIGINS=https://reversr-rebuild.example.com
API_REQUEST_BODY_LIMIT=50mb

# Optional Gemini keys for production AI-backed analysis and generation.
AI_INTEGRATIONS_GEMINI_API_KEY=
GEMINI_API_KEYS=

# Server-side inventory connector credentials.
# The mobile app stores only connector.credentialRef, never raw secrets.
# Example:
# INVENTORY_CONNECTOR_SECRETS_JSON={"partsledger-prod":{"headerName":"X-API-Key","value":"replace-me"},"maintenance-oauth":{"token":"replace-me"}}
INVENTORY_CONNECTOR_SECRETS_JSON={}

# Optional runtime registry for admin-managed connector credentials.
ADMIN_API_TOKEN=
INVENTORY_CONNECTOR_SECRETS_FILE=.reversr-connector-secrets.json

# Private-network connectors are disabled unless this is explicitly enabled on a controlled API host.
INVENTORY_PRIVATE_NETWORK_ENABLED=false
